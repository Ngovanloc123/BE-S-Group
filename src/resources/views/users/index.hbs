

<div class="row">
    <div class="col-lg-7"><h2 class="">Danh sách người dùng</h2></div>
    <div class="col-lg-3"><a
            href="/users/add"
            class="btn btn-primary my-4"
            id="add-user-btn"
        >Thêm người dùng</a></div>
</div>
<table class="table table-striped">
    <thead>
        <tr>
            <th scope="col">Tên người dùng</th>
            <th scope="col">Email</th>
            <th scope="col">Mật khẩu</th>
            <th scope="col"></th>
        </tr>
    </thead>
    <tbody id="user-list">
        {{#each users}}
            <tr>
                <td>{{this.name}}</td>
                <td>{{this.email}}</td>
                <td>{{this.password}}</td>
                <td>
                    <button
                        data-bs-id="{{this.id}}"
                        name="{{this.name}}"
                        class="btn btn-danger delete-btn"
                        data-bs-target="#delete-user-modal"
                        data-bs-toggle="modal"
                    >Xoá</button>
                    <a
                        href="/users/edit/{{this.id}}"
                        class="btn btn-warning edit-btn mt-lg-0 mt-sm-2"
                        id="add-user-btn"
                    >Sửa</a>
                </td>
            </tr>
        {{/each}}
    </tbody>
</table>

{{!-- Dialog Delete --}}
<div id="delete-user-modal" class="modal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Xoá user?</h5>
                <button
                    type="button"
                    class="close"
                    data-bs-dismiss="modal"
                    aria-label="Close"
                >
                </button>
            </div>
            <div class="modal-body">
                <p>Bạn chắc chắn muốn xoá user này?</p>
            </div>
            <div class="modal-footer">
                <button
                    id="btn-delete-user"
                    type="button"
                    class="btn btn-danger"
                >Xoá bỏ</button>
                <button
                    type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="modal"
                >Huỷ</button>
            </div>
        </div>
    </div>
</div>

<form method="POST" name="delete-user-form"></form>

<script>
    const deleteUserModal = document.getElementById('delete-user-modal'); 
    var userId; 

    if (deleteUserModal) {
        deleteUserModal.addEventListener('show.bs.modal', event => { 
            const button = event.relatedTarget;
            userId = button.getAttribute('data-bs-id');
        
        }); 
    }

    var deleteForm = document.forms['delete-user-form'];
    var btnDeleteUser = document.getElementById('btn-delete-user');
    btnDeleteUser.onclick = function() {
        deleteForm.action = '/users/' + userId + '?_method=DELETE';
        deleteForm.submit();
    }

</script>